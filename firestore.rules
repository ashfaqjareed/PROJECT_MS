rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /customers/{phone} {
      allow read, update: if request.auth != null && request.auth.token.email == phone + '@multisuper.lk';
      allow create: if request.auth != null && request.auth.token.email == phone + '@multisuper.lk';
    }
    match /offers/{doc} { allow read: if true; allow write: if false; }
    match /rates/{doc} { allow read: if true; allow write: if false; }
    match /stock/{doc} { allow read: if true; allow write: if false; }
    match /newsletter_subscribers/{doc} { allow create: if true; allow read: if false; }
    match /pamphlet_subscribers/{doc} {
      allow read: if false;
      allow create: if true;
    }
  }
}
